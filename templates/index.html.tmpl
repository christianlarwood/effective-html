<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Claude HTML Artifacts</title>
<style>
  :root {
    --bg: #fafaf7;
    --fg: #1c1c1a;
    --muted: #6b6b66;
    --accent: #2d4a3e;
    --rule: #e6e3da;
    --row-hover: #f1ede2;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #15161a;
      --fg: #ececea;
      --muted: #8a8a85;
      --accent: #8fc6a6;
      --rule: #2a2b30;
      --row-hover: #1f2025;
    }
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 15px/1.55 ui-serif, Georgia, "New York", serif;
    padding: 3rem 1.5rem 6rem;
  }
  main { max-width: 920px; margin: 0 auto; }
  h1 { font-size: 1.7rem; font-weight: 600; margin: 0 0 .25rem; letter-spacing: -0.01em; }
  .sub { color: var(--muted); margin: 0 0 2rem; font-size: .95rem; }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: .7rem .6rem; border-bottom: 1px solid var(--rule); vertical-align: top; }
  th { font-size: .75rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }
  tr:hover td { background: var(--row-hover); }
  a { color: var(--accent); text-decoration: none; }
  a:hover { text-decoration: underline; }
  .when { white-space: nowrap; font-variant-numeric: tabular-nums; color: var(--muted); font-size: .85rem; }
  .project { font-family: ui-monospace, Menlo, monospace; font-size: .82rem; color: var(--muted); }
  .desc { color: var(--muted); font-size: .88rem; }
  .empty { color: var(--muted); padding: 2rem 0; font-style: italic; }
</style>
</head>
<body>
<main>
  <h1>Claude HTML Artifacts</h1>
  <p class="sub">Generated by the <code>html-artifact</code> skill. Newest first.</p>
  <table>
    <thead>
      <tr><th>When</th><th>Project</th><th>Title</th><th>Notes</th></tr>
    </thead>
    <tbody id="artifact-list">
      <!-- ENTRIES_BELOW -->
      <tr><td colspan="4" class="empty">No artifacts yet. Run <code>/preview</code> to make one.</td></tr>
      <!-- ENTRIES_ABOVE -->
    </tbody>
  </table>
</main>
</body>
</html>
